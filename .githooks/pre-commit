#!/usr/bin/env bash
# Format Rust, then restage only Rust files already included in this commit.
# Unrelated tracked files (such as local IDE settings) must remain untouched.
set -e
staged_rust=$(mktemp)
trap 'rm -f "$staged_rust"' EXIT
git diff --cached --name-only --diff-filter=ACM -z -- '*.rs' > "$staged_rust"
cargo fmt --all
if [ -s "$staged_rust" ]; then
  git --literal-pathspecs add --pathspec-from-file="$staged_rust" --pathspec-file-nul
fi
